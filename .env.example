# =============================================================================
# Rani Portfolio — Environment Variables Template
# =============================================================================
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# Every variable below MUST be set in your Vercel project too (Settings →
# Environment Variables) for the production deployment to work.
# =============================================================================

# --- Auth (required) ---------------------------------------------------------

# Admin panel password. Generate a strong random value (≥ 16 chars).
# Used for bcrypt comparison in lib/auth.ts.
ADMIN_PASSWORD=

# Cookie value for the admin session cookie (`rani_admin_session`). The cookie
# set by `loginAction` is compared byte-for-byte against this value in the
# proxy and in `isAuthenticated()`. Use ≥ 32 random chars.
COOKIE_SECRET=

# Optional: pre-hashed password (bcrypt). If set, takes precedence over the
# plain ADMIN_PASSWORD above. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PLAIN', 10))"
# ADMIN_PASSWORD_HASH=

# --- Content storage (Supabase Postgres — recommended) ------------------------

# Full PostgreSQL connection string (Supabase direct connection). The proxy
# detects the Postgres backend automatically when this is set.
# Format: postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_DB_URL=

# --- Optional: Vercel-native upload storage (Blob) ----------------------------

# When unset, uploads use GH_TOKEN and the GitHub Contents API (1MB CV limit).
# BLOB_READ_WRITE_TOKEN=

# --- Optional: Vercel-native content storage (KV) -----------------------------

# Only needed if you use Vercel-managed storage for editable content.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Optional: GitHub-backed storage (zero-setup, commits to repo) -----------
# A fine-grained PAT with `contents: write` on the repo that should host
# content/{locale}.json. Used as a fallback when no Supabase / KV is set.
# On Vercel, repo is auto-detected via VERCEL_GIT_REPO_OWNER /
# VERCEL_GIT_REPO_SLUG, so usually only the token is required.
GH_TOKEN=

# Override auto-detection of the GitHub repo (only needed outside Vercel):
# GH_REPO_OWNER=your-org
# GH_REPO_NAME=rani-portfolio
# GH_REPO_BRANCH=main

# --- Misc --------------------------------------------------------------------

# Vercel CLI token (used only by local helper scripts, never committed).
# TOKEN_VERCEL_SECRET=
